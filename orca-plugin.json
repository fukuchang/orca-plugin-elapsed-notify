{
  "manifestVersion": 1,
  "id": "elapsed-notify",
  "publisher": "local",
  "name": "Elapsed Time Notify",
  "version": "1.1.1",
  "description": "エージェントが working になってから50分・55分で放置を通知し、55分でorca CLI経由で/compactを自動実行する（Claude prompt cacheの1時間TTL切れ対策）",
  "engines": { "orca": ">=1.4.0" },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "events": [
      { "on": "worktree.created" },
      { "on": "worktree.removed" },
      { "on": "agent.status.changed" }
    ]
  },
  "capabilities": [
    { "kind": "events:subscribe" },
    { "kind": "notifications:show" },
    { "kind": "storage" }
  ]
}
